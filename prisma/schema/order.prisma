// Orders, shipments, fulfillment, and delivery records

model Order {
  id                         String                      @id @default(cuid())
  orderNumber                String                      @unique
  checkoutIdempotencyKey     String?                     @unique
  customerUserId             String
  customerUser               User                        @relation("CustomerOrders", fields: [customerUserId], references: [id], onDelete: Restrict)
  shippingAddressId          String?
  shippingAddress            SavedAddress?               @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingAddressSnapshot    Json
  paymentStatus              OrderPaymentStatus          @default(UNPAID)
  fulfillmentStatus          FulfillmentStatus           @default(PLACED)
  currency                   String                      @default("BDT")
  fxRateScaled               BigInt?
  fxRateScale                Int?
  fxBaseCurrency             String?
  fxQuoteCurrency            String?
  subtotalPoisha             BigInt
  discountPoisha             BigInt                      @default(0)
  careuFundedDiscountPoisha  BigInt                      @default(0)
  sellerFundedDiscountPoisha BigInt                      @default(0)
  discountReference          String?
  deliveryPoisha             BigInt                      @default(0)
  taxPoisha                  BigInt                      @default(0)
  totalPoisha                BigInt
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  shipments                  Shipment[]
  items                      OrderItem[]
  statusHistory              OrderStatusHistory[]
  paymentStatusHistory       OrderPaymentStatusHistory[]
  payments                   Payment[]
  refunds                    Refund[]
  financialLedgerEntries     FinancialLedgerEntry[]
  codReconciliationRecords   CODReconciliationRecord[]
  supportCases               SupportCase[]
  disputes                   Dispute[]
  stockReservations          StockReservation[]

  @@index([customerUserId])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
  @@map("order")
}

model Shipment {
  id                       String                    @id @default(cuid())
  orderId                  String
  order                    Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shopId                   String
  shop                     Shop                      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shipmentNumber           String                    @unique
  fulfillmentStatus        FulfillmentStatus         @default(PLACED)
  deliveryMethod           String?
  deliveryChargePoisha     BigInt                    @default(0)
  destinationSnapshot      Json?
  trackingCode             String?
  carrierName              String?
  notes                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  items                    OrderItem[]
  statusHistory            ShipmentStatusHistory[]
  deliveryAssignments      DeliveryAssignment[]
  proofsOfDelivery         ProofOfDelivery[]
  refunds                  Refund[]
  disputes                 Dispute[]
  codReconciliationRecords CODReconciliationRecord[]
  financialLedgerEntries   FinancialLedgerEntry[]
  mediaAssets              MediaAsset[]              @relation("ShipmentMediaAssets")

  // One seller specific shipment per shop in an order. Delivery charge and
  // payout eligibility are recorded per shipment, so a duplicate would double count.
  @@unique([orderId, shopId])
  @@index([orderId])
  @@index([shopId])
  @@index([fulfillmentStatus])
  @@map("shipment")
}

model OrderItem {
  id                         String                 @id @default(cuid())
  orderId                    String
  order                      Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipmentId                 String
  shipment                   Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  shopId                     String
  shop                       Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  listingId                  String
  listing                    Listing                @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingVariantId           String
  listingVariant             ListingVariant         @relation(fields: [listingVariantId], references: [id], onDelete: Restrict)
  titleSnapshot              String
  skuSnapshot                String
  variantSnapshot            Json?
  unitPricePoisha            BigInt
  quantity                   Int
  discountPoisha             BigInt                 @default(0)
  careuFundedDiscountPoisha  BigInt                 @default(0)
  sellerFundedDiscountPoisha BigInt                 @default(0)
  discountReference          String?
  taxPoisha                  BigInt                 @default(0)
  commissionRuleId           String?
  commissionRule             CommissionRule?        @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  commissionRateBps          Int?
  commissionBasePoisha       BigInt
  commissionPoisha           BigInt
  lineTotalPoisha            BigInt
  currency                   String                 @default("BDT")
  // Item level only. The PARTIALLY_* states describe an order or a shipment,
  // never a single line, and a migration check rejects them here.
  fulfillmentStatus          FulfillmentStatus      @default(PLACED)
  metadata                   Json?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  reviews                    Review[]
  supportCases               SupportCase[]
  disputes                   Dispute[]
  refunds                    Refund[]
  financialLedgerEntries     FinancialLedgerEntry[]

  @@index([orderId])
  @@index([shipmentId])
  @@index([shopId])
  @@index([listingVariantId])
  @@map("order_item")
}

model OrderStatusHistory {
  id          String             @id @default(cuid())
  orderId     String
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromStatus  FulfillmentStatus?
  toStatus    FulfillmentStatus
  actorUserId String?
  actorUser   User?              @relation("OrderStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime           @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderPaymentStatusHistory {
  id          String              @id @default(cuid())
  orderId     String
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromStatus  OrderPaymentStatus?
  toStatus    OrderPaymentStatus
  actorUserId String?
  actorUser   User?               @relation("OrderPaymentStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime            @default(now())

  @@index([orderId, createdAt])
  @@map("order_payment_status_history")
}

model ShipmentStatusHistory {
  id          String             @id @default(cuid())
  shipmentId  String
  shipment    Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  fromStatus  FulfillmentStatus?
  toStatus    FulfillmentStatus
  actorUserId String?
  actorUser   User?              @relation("ShipmentStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime           @default(now())

  @@index([shipmentId, createdAt])
  @@map("shipment_status_history")
}

model DeliveryAssignment {
  id           String                   @id @default(cuid())
  shipmentId   String
  shipment     Shipment                 @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  assigneeType DeliveryAssigneeType
  assigneeId   String?
  status       DeliveryAssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime                 @default(now())
  notes        String?
  metadata     Json?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([shipmentId])
  @@index([assigneeType, assigneeId])
  @@map("delivery_assignment")
}

model ProofOfDelivery {
  id               String   @id @default(cuid())
  shipmentId       String
  shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  type             String
  recipientName    String?
  mediaStorageKey  String?
  capturedAt       DateTime @default(now())
  capturedByUserId String?
  capturedByUser   User?    @relation("ProofOfDeliveryCapturer", fields: [capturedByUserId], references: [id], onDelete: SetNull)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shipmentId])
  @@map("proof_of_delivery")
}
