// Payments, refunds, money records, and COD reconciliation

model Payment {
  id                     String                 @id @default(cuid())
  orderId                String
  order                  Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  idempotencyKey         String?                @unique
  method                 PaymentMethod
  provider               String?
  providerReference      String?
  canonicalStatus        PaymentCanonicalStatus @default(INITIATED)
  amountPoisha           BigInt
  currency               String                 @default("BDT")
  initiatedAt            DateTime               @default(now())
  settledAt              DateTime?
  metadata               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  events                 PaymentEvent[]
  financialLedgerEntries FinancialLedgerEntry[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([canonicalStatus])
  @@map("payment")
}

model PaymentEvent {
  id                 String                         @id @default(cuid())
  paymentId          String?
  payment            Payment?                       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  provider           String
  eventKey           String                         @unique
  eventType          String
  verificationStatus PaymentEventVerificationStatus @default(UNVERIFIED)
  receivedAt         DateTime                       @default(now())
  payload            Json?
  processingResult   String?
  metadata           Json?
  createdAt          DateTime                       @default(now())

  @@index([paymentId])
  @@index([provider])
  @@index([receivedAt])
  @@map("payment_event")
}

model Refund {
  id                     String                 @id @default(cuid())
  idempotencyKey         String?                @unique
  orderId                String
  order                  Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipmentId             String?
  shipment               Shipment?              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItemId            String?
  orderItem              OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  amountPoisha           BigInt
  currency               String                 @default("BDT")
  method                 RefundMethod?
  status                 RefundStatus           @default(REQUESTED)
  reason                 String?
  requestedByUserId      String?
  requestedByUser        User?                  @relation("RefundRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId       String?
  approvedByUser         User?                  @relation("RefundApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  providerReference      String?
  transactionReference   String?
  metadata               Json?
  requestedAt            DateTime               @default(now())
  approvedAt             DateTime?
  processedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  financialLedgerEntries FinancialLedgerEntry[]

  @@index([orderId])
  @@index([shipmentId])
  @@index([orderItemId])
  @@index([status])
  @@map("refund")
}

model CommissionRule {
  id            String      @id @default(cuid())
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Stays a free string until commission scoping policy is decided. A category
  // scoped rule must carry categoryId, enforced by a migration check.
  scopeType     String      @default("category")
  rateBps       Int
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  active        Boolean     @default(true)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([active])
  @@map("commission_rule")
}

model FinancialLedgerEntry {
  id                String                   @id @default(cuid())
  idempotencyKey    String?                  @unique
  shopId            String?
  shop              Shop?                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  orderId           String?
  order             Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipmentId        String?
  shipment          Shipment?                @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItemId       String?
  orderItem         OrderItem?               @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  paymentId         String?
  payment           Payment?                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundId          String?
  refund            Refund?                  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  payoutBatchId     String?
  payoutBatch       PayoutBatch?             @relation(fields: [payoutBatchId], references: [id], onDelete: Restrict)
  entryType         LedgerEntryType
  amountPoisha      BigInt
  currency          String                   @default("BDT")
  direction         LedgerDirection
  eligibilityStatus LedgerEligibilityStatus?
  reason            String?
  actorUserId       String?
  actorUser         User?                    @relation("FinancialLedgerActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata          Json?
  createdAt         DateTime                 @default(now())

  @@index([shopId])
  @@index([orderId])
  @@index([shipmentId])
  @@index([orderItemId])
  @@index([paymentId])
  @@index([refundId])
  @@index([payoutBatchId])
  @@index([entryType])
  @@index([createdAt])
  @@map("financial_ledger_entry")
}

model PayoutBatch {
  id                String                 @id @default(cuid())
  status            PayoutBatchStatus      @default(DRAFT)
  method            String?
  destinationRef    String?
  totalAmountPoisha BigInt                 @default(0)
  currency          String                 @default("BDT")
  approvedByUserId  String?
  approvedByUser    User?                  @relation("PayoutBatchApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  approvalReason    String?
  processedAt       DateTime?
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  items             PayoutItem[]
  ledgerEntries     FinancialLedgerEntry[]

  @@index([status])
  @@index([approvedByUserId])
  @@map("payout_batch")
}

model PayoutItem {
  id                   String           @id @default(cuid())
  idempotencyKey       String?          @unique
  payoutBatchId        String
  payoutBatch          PayoutBatch      @relation(fields: [payoutBatchId], references: [id], onDelete: Restrict)
  shopId               String
  shop                 Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  amountPoisha         BigInt
  currency             String           @default("BDT")
  method               String?
  destinationRef       String?
  status               PayoutItemStatus @default(PENDING)
  transactionReference String?
  failureReason        String?
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([payoutBatchId])
  @@index([shopId])
  @@index([status])
  @@map("payout_item")
}

model CODReconciliationRecord {
  id               String                      @id @default(cuid())
  orderId          String?
  order            Order?                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipmentId       String?
  shipment         Shipment?                   @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  shopId           String?
  shop             Shop?                       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  recordType       CODReconciliationRecordType
  amountPoisha     BigInt
  currency         String                      @default("BDT")
  status           CODReconciliationStatus     @default(OPEN)
  evidenceRef      String?
  reason           String?
  actorUserId      String?
  actorUser        User?                       @relation("CODReconciliationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByUser   User?                       @relation("CODReconciliationResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  // One to one: a resolution record closes exactly one earlier open record.
  resolvesRecordId String?                     @unique
  resolvesRecord   CODReconciliationRecord?    @relation("CODResolutionLink", fields: [resolvesRecordId], references: [id], onDelete: Restrict)
  resolvedByRecord CODReconciliationRecord?    @relation("CODResolutionLink")
  metadata         Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([orderId])
  @@index([shipmentId])
  @@index([shopId])
  @@index([status])
  @@index([recordType])
  @@index([resolvedByUserId])
  @@map("cod_reconciliation_record")
}
