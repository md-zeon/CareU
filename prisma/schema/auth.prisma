model User {
    id                  String    @id
    name                String
    email               String
    emailVerified       Boolean   @default(false)
    image               String?
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt
    phoneNumber         String?
    phoneNumberVerified Boolean?
    sessions            Session[]
    accounts            Account[]

    sellerApplications          SellerApplication[] @relation("SellerApplicationApplicant")
    reviewedSellerApplications  SellerApplication[] @relation("SellerApplicationReviewer")
    ownedShops                  Shop[]              @relation("ShopOwner")
    shopMemberships             ShopMembership[]    @relation("ShopMember")
    invitedShopMemberships      ShopMembership[]    @relation("ShopMembershipInviter")
    createdProducts             Product[]           @relation("ProductCreator")
    stockMovements              StockMovement[]     @relation("StockMovementActor")
    savedAddresses              SavedAddress[]
    wishlist                    Wishlist?
    orders                      Order[]             @relation("CustomerOrders")
    orderStatusChanges          OrderStatusHistory[] @relation("OrderStatusActor")
    orderPaymentStatusChanges   OrderPaymentStatusHistory[] @relation("OrderPaymentStatusActor")
    shipmentStatusChanges       ShipmentStatusHistory[] @relation("ShipmentStatusActor")
    proofsOfDeliveryCaptured    ProofOfDelivery[]   @relation("ProofOfDeliveryCapturer")
    refundsRequested            Refund[]            @relation("RefundRequester")
    refundsApproved             Refund[]            @relation("RefundApprover")
    financialLedgerActions      FinancialLedgerEntry[] @relation("FinancialLedgerActor")
    codReconciliationActions    CODReconciliationRecord[] @relation("CODReconciliationActor")
    codReconciliationResolutions CODReconciliationRecord[] @relation("CODReconciliationResolver")
    payoutBatchesApproved       PayoutBatch[]       @relation("PayoutBatchApprover")
    reviews                     Review[]
    supportCases                SupportCase[]       @relation("SupportCaseCustomer")
    assignedSupportCases        SupportCase[]       @relation("SupportCaseAssignee")
    supportCaseStatusChanges    SupportCaseStatusHistory[] @relation("SupportCaseStatusActor")
    supportMessages             SupportMessage[]    @relation("SupportMessageAuthor")
    disputesOpened              Dispute[]           @relation("DisputeOpener")
    disputesResolved            Dispute[]           @relation("DisputeResolver")
    notificationStatusChanges   NotificationStatusHistory[] @relation("NotificationStatusActor")
    notifications               Notification[]      @relation("NotificationRecipient")
    auditLogs                   AuditLog[]          @relation("AuditLogActor")

    platformRoleAssignments     PlatformRoleAssignment[] @relation("PlatformRoleHolder")
    grantedPlatformRoles        PlatformRoleAssignment[] @relation("PlatformRoleGranter")
    revokedPlatformRoles        PlatformRoleAssignment[] @relation("PlatformRoleRevoker")

    @@unique([email])
    @@unique([phoneNumber])
    @@map("user")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

model RateLimit {
    id          String @id
    key         String
    count       Int
    lastRequest BigInt

    @@unique([key])
    @@map("rateLimit")
}
